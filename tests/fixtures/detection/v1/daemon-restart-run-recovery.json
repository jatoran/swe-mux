{
  "schema_version": 1,
  "backend": "claude",
  "description": "Daemon restart forgets volatile completion evidence and requires a fresh root lifecycle boundary.",
  "steps": [
    {"kind": "hook", "event": "UserPromptSubmit"},
    {"kind": "hook", "event": "Stop"},
    {"kind": "terminal", "mode": "normal"},
    {"kind": "timer", "seconds": 2.1, "expect_delivery": "safe", "oracle_safe": true},
    {"kind": "restart", "expect_delivery": "unknown", "oracle_safe": false},
    {"kind": "hook", "event": "UserPromptSubmit", "expect_delivery": "blocked", "oracle_safe": false},
    {"kind": "hook", "event": "Stop"},
    {"kind": "timer", "seconds": 2.1, "expect_delivery": "safe", "oracle_safe": true}
  ],
  "expected": {
    "events": [
      {"type": "turn_started", "source": "hook", "scope": "root"},
      {"type": "turn_ended", "source": "hook", "scope": "root", "outcome": "completed"},
      {"type": "turn_started", "source": "hook", "scope": "root"},
      {"type": "turn_ended", "source": "hook", "scope": "root", "outcome": "completed"}
    ],
    "parser": {"status": "watching", "recognized": 0, "unknown": 0, "unknown_signatures": {}},
    "delivery_state": "safe",
    "delivery_reason": "all_required_evidence_positive"
  }
}
