{
  "schema_version": 1,
  "backend": "pi",
  "description": "The pi extension reports a root turn and tool lifecycle in order. A pi turn_end is a milestone between agent steps, so only agent_end closes the root run.",
  "steps": [
    {"kind": "hook", "event": "SessionStart", "payload": {"source": "startup", "session_id": "pi-hooked", "transcript_path": "pi.jsonl", "pi_event": "session_start"}},
    {"kind": "hook", "event": "UserPromptSubmit", "payload": {"prompt": "inspect", "pi_event": "before_agent_start"}, "expect_state": "working"},
    {"kind": "hook", "event": "task_started", "payload": {"pi_event": "agent_start"}},
    {"kind": "hook", "event": "turn_started", "payload": {"turn_index": 0, "pi_event": "turn_start"}},
    {"kind": "hook", "event": "PreToolUse", "payload": {"tool_name": "bash", "tool_use_id": "call-1", "pi_event": "tool_call"}},
    {"kind": "hook", "event": "PostToolUse", "payload": {"tool_name": "bash", "tool_use_id": "call-1", "pi_event": "tool_result"}},
    {"kind": "hook", "event": "turn_ended", "payload": {"turn_index": 0, "root_completion": false, "pi_event": "turn_end"}, "expect_state": "working"},
    {"kind": "hook", "event": "task_complete", "payload": {"will_continue": false, "pi_event": "agent_end"}, "expect_state": "idle"}
  ],
  "expected": {
    "events": [
      {"type": "turn_started", "source": "hook", "scope": "root"},
      {"type": "tool_use", "source": "hook", "scope": "root", "tool": "bash"},
      {"type": "provider_turn_ended", "source": "hook", "scope": "root"},
      {"type": "turn_ended", "source": "hook", "scope": "root", "outcome": "completed"}
    ],
    "states": [
      {"previous": "idle", "state": "working", "source": "hook", "proof": "proven"},
      {"previous": "working", "state": "idle", "source": "hook", "proof": "proven"}
    ],
    "parser": {"status": "watching", "recognized": 0, "unknown": 0, "unknown_signatures": {}},
    "delivery_state": "unknown",
    "delivery_reason": "readiness_debounce_pending"
  }
}
