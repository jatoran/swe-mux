{
  "schema_version": 1,
  "backend": "claude",
  "edge_case": "standing_annotation_never_latches",
  "description": "A loop whose wakeup never fires (killed loop runner, crashed schedule) must not display forever: the annotation's evidence-implied expiry (delaySeconds + slack) decays it in the watchdog's TTL sweep, counted in status health as standing_activity_expired.",
  "steps": [
    {
      "kind": "transcript",
      "ts_offset": 0,
      "record": {
        "type": "user",
        "isSidechain": false,
        "message": {
          "content": "poll the queue"
        }
      },
      "expect_state": "working"
    },
    {
      "kind": "transcript",
      "ts_offset": 1,
      "record": {
        "type": "assistant",
        "isSidechain": false,
        "message": {
          "content": [
            {
              "type": "tool_use",
              "id": "toolu_wake1",
              "name": "ScheduleWakeup",
              "input": {
                "delaySeconds": 300,
                "reason": "poll",
                "prompt": "/loop poll the queue"
              }
            }
          ]
        }
      }
    },
    {
      "kind": "transcript",
      "ts_offset": 2,
      "record": {
        "type": "system",
        "subtype": "turn_duration",
        "durationMs": 900
      },
      "expect_state": "idle",
      "expect_standing": [
        {
          "kind": "loop",
          "source": "transcript",
          "evidence": "transcript:ScheduleWakeup",
          "count": 1,
          "detail": "poll",
          "expires": true
        }
      ]
    },
    {
      "kind": "pty",
      "data": "\u001b[?1049h"
    },
    {
      "kind": "timer",
      "seconds": 500
    },
    {
      "kind": "watchdog",
      "expect_state": "idle",
      "expect_standing": []
    },
    {
      "kind": "timer",
      "seconds": 2.1,
      "expect_delivery": "safe",
      "oracle_safe": true,
      "expect_state": "idle",
      "expect_standing": []
    }
  ],
  "expected": {
    "events": [
      {
        "type": "turn_started",
        "source": "transcript",
        "scope": "root"
      },
      {
        "type": "tool_use",
        "source": "transcript",
        "scope": "root",
        "tool": "ScheduleWakeup"
      },
      {
        "type": "turn_ended",
        "source": "transcript",
        "scope": "root",
        "outcome": "completed"
      }
    ],
    "states": [
      {
        "previous": "idle",
        "state": "working",
        "source": "transcript",
        "proof": "proven"
      },
      {
        "previous": "working",
        "state": "idle",
        "source": "transcript",
        "proof": "proven"
      }
    ],
    "standing": [],
    "parser": {
      "status": "ready",
      "recognized": 3,
      "unknown": 0,
      "unknown_signatures": {}
    },
    "delivery_state": "safe",
    "delivery_reason": "all_required_evidence_positive"
  }
}
