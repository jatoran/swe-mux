{
  "schema_version": 1,
  "backend": "claude",
  "description": "Native hook and transcript evidence for one root turn coalesce into one semantic start and completion.",
  "steps": [
    {"kind": "hook", "event": "UserPromptSubmit", "payload": {}, "expect_delivery": "blocked", "oracle_safe": false, "expect_state": "working"},
    {"kind": "transcript", "record": {"type": "user", "isSidechain": false, "message": {"content": "test"}}},
    {"kind": "hook", "event": "Stop", "payload": {}},
    {"kind": "transcript", "record": {"type": "assistant", "isSidechain": false, "message": {"content": [{"type": "text", "text": "done"}], "stop_reason": "end_turn"}}},
    {"kind": "terminal", "mode": "normal"},
    {"kind": "timer", "seconds": 2.1, "expect_delivery": "safe", "oracle_safe": true, "expect_state": "idle"}
  ],
  "expected": {
    "events": [
      {"type": "turn_started", "source": "hook", "scope": "root"},
      {"type": "turn_ended", "source": "hook", "scope": "root", "outcome": "completed"}
    ],
    "states": [
      {"previous": "idle", "state": "working", "source": "hook", "proof": "proven"},
      {"previous": "working", "state": "idle", "source": "hook", "proof": "proven"}
    ],
    "parser": {"status": "ready", "recognized": 2, "unknown": 0, "unknown_signatures": {}},
    "delivery_state": "safe",
    "delivery_reason": "all_required_evidence_positive"
  }
}
