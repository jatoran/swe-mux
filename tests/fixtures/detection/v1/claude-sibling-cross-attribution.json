{
  "schema_version": 1,
  "backend": "claude",
  "edge_case": "sibling_transcript_cross_attribution",
  "description": "An observer stuck on a sibling's transcript supplies no terminal evidence for this session; the PTY backstop (this session's own ground truth) still recovers it.",
  "steps": [
    {"kind": "hook", "event": "UserPromptSubmit", "payload": {}, "expect_delivery": "blocked", "oracle_safe": false, "expect_state": "working"},
    {"kind": "transcript_tail", "records": [{"type": "assistant", "isSidechain": false, "message": {"content": [{"type": "tool_use", "id": "sib-1", "name": "Edit", "input": {}}], "stop_reason": "tool_use"}}, {"type": "user", "isSidechain": false, "message": {"content": [{"type": "tool_result", "tool_use_id": "sib-1", "content": "sibling work", "is_error": false}]}}]},
    {"kind": "pty_tail", "data": "\u276f  ? for shortcuts"},
    {"kind": "timer", "seconds": 59},
    {"kind": "watchdog", "expect_state": "working"},
    {"kind": "timer", "seconds": 2},
    {"kind": "watchdog", "expect_state": "idle"}
  ],
  "expected": {
    "events": [
      {"type": "turn_started", "source": "hook", "scope": "root"},
      {"type": "turn_ended", "source": "watchdog-pty", "scope": "root", "outcome": "completed"}
    ],
    "states": [
      {"previous": "idle", "state": "working", "source": "hook", "proof": "proven"},
      {"previous": "working", "state": "idle", "source": "watchdog-pty", "proof": "inferred"}
    ],
    "parser": {"status": "watching", "recognized": 0, "unknown": 0, "unknown_signatures": {}},
    "delivery_state": "unknown",
    "delivery_reason": "observation_capability_unknown"
  }
}
