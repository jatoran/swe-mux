{
  "schema_version": 1,
  "backend": "opencode",
  "description": "opencode's plugin carries the whole root turn. Unlike pi and omp, opencode has a single unambiguous root-completion signal - the bus emits exactly one session.idle per turn (measured against opencode 1.18.16) - so turn_ended is reported with root_completion true rather than as a milestone.",
  "steps": [
    {
      "kind": "hook",
      "event": "SessionStart",
      "payload": {
        "source": "startup",
        "session_id": "ses_012e2258bffeDxM8MvkzWOVEOx",
        "server_url": "http://127.0.0.1:49999",
        "opencode_event": "session.created"
      }
    },
    {
      "kind": "hook",
      "event": "UserPromptSubmit",
      "payload": {
        "agent": "build",
        "opencode_event": "chat.message"
      },
      "expect_state": "working"
    },
    {
      "kind": "hook",
      "event": "turn_started",
      "payload": {
        "status": "busy",
        "opencode_event": "session.status"
      }
    },
    {
      "kind": "hook",
      "event": "PreToolUse",
      "payload": {
        "tool_name": "bash",
        "tool_use_id": "call-1"
      }
    },
    {
      "kind": "hook",
      "event": "PostToolUse",
      "payload": {
        "tool_name": "bash",
        "tool_use_id": "call-1"
      }
    },
    {
      "kind": "hook",
      "event": "turn_ended",
      "payload": {
        "root_completion": true,
        "opencode_event": "session.idle"
      },
      "expect_state": "idle"
    }
  ],
  "expected": {
    "events": [
      {
        "type": "agent_native_id_bound",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "turn_started",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "tool_use",
        "source": "hook",
        "scope": "root",
        "tool": "bash"
      },
      {
        "type": "turn_ended",
        "source": "hook",
        "scope": "root",
        "outcome": "completed"
      }
    ],
    "states": [
      {
        "previous": "idle",
        "state": "working",
        "source": "hook",
        "proof": "proven"
      },
      {
        "previous": "working",
        "state": "idle",
        "source": "hook",
        "proof": "proven"
      }
    ],
    "parser": {
      "status": "watching",
      "recognized": 0,
      "unknown": 0,
      "unknown_signatures": {}
    },
    "delivery_state": "unknown",
    "delivery_reason": "readiness_debounce_pending"
  }
}
