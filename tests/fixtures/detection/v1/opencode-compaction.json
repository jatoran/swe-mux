{
  "schema_version": 1,
  "backend": "opencode",
  "description": "opencode reports compaction through its own bus event rather than a transcript record, so `context_compacted` arrives on the hook channel and must be attributed to the root turn without ending it.",
  "steps": [
    {
      "kind": "hook",
      "event": "SessionStart",
      "payload": {
        "source": "startup",
        "session_id": "ses_01cc7a41ddeeQxT4MnpqBRs9Lk",
        "opencode_event": "session.created"
      }
    },
    {
      "kind": "hook",
      "event": "UserPromptSubmit",
      "payload": {
        "agent": "build",
        "opencode_event": "chat.message"
      },
      "expect_state": "working"
    },
    {
      "kind": "hook",
      "event": "context_compacted",
      "payload": {
        "compaction_id": "cmp-1",
        "opencode_event": "session.compacted"
      },
      "expect_state": "working"
    },
    {
      "kind": "hook",
      "event": "turn_ended",
      "payload": {
        "root_completion": true,
        "opencode_event": "session.idle"
      },
      "expect_state": "idle"
    }
  ],
  "expected": {
    "events": [
      {
        "type": "agent_native_id_bound",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "turn_started",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "context_compacted",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "turn_ended",
        "source": "hook",
        "scope": "root",
        "outcome": "completed"
      }
    ],
    "states": [
      {
        "previous": "idle",
        "state": "working",
        "source": "hook",
        "proof": "proven"
      },
      {
        "previous": "working",
        "state": "idle",
        "source": "hook",
        "proof": "proven"
      }
    ],
    "parser": {
      "status": "watching",
      "recognized": 0,
      "unknown": 0,
      "unknown_signatures": {}
    },
    "delivery_state": "unknown",
    "delivery_reason": "readiness_debounce_pending"
  }
}
