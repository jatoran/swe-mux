{
  "schema_version": 1,
  "backend": "opencode",
  "description": "Two conversations in one opencode pane, exercising the post-rollover filter rather than the rollover itself. The replay runner calls apply_hook_observation directly and never runs the rollover decision that production runs first, so a second SessionStart necessarily reads as a foreign conversation here. That is a property of the runner, not of opencode: verified live 2026-08-10 that /new in a real pane rolls correctly, minting a new ses_ id and a new agent run with no refusal. What this fixture does pin is that a hook naming a conversation this session is not bound to cannot move its state - the guard that stops a foreign PermissionRequest raising an unanswerable approval. The plugin reports source `new` for a replacement because `startup` means a fresh process and is refused as a rollover by contract.",
  "steps": [
    {
      "kind": "hook",
      "event": "SessionStart",
      "payload": {
        "source": "startup",
        "session_id": "ses_01aa2258bffeDxM8MvkzWOVEOx",
        "opencode_event": "session.created"
      }
    },
    {
      "kind": "hook",
      "event": "UserPromptSubmit",
      "payload": {
        "agent": "build",
        "opencode_event": "chat.message"
      },
      "expect_state": "working"
    },
    {
      "kind": "hook",
      "event": "turn_ended",
      "payload": {
        "root_completion": true,
        "opencode_event": "session.idle"
      },
      "expect_state": "idle"
    },
    {
      "kind": "hook",
      "event": "SessionStart",
      "payload": {
        "source": "new",
        "session_id": "ses_01bb9f13ccadRfN2QqrtZLKPUy",
        "opencode_event": "session.created",
        "previous_session_id": "ses_01aa2258bffeDxM8MvkzWOVEOx"
      }
    },
    {
      "kind": "hook",
      "event": "UserPromptSubmit",
      "payload": {
        "agent": "build",
        "opencode_event": "chat.message"
      },
      "expect_state": "working"
    },
    {
      "kind": "hook",
      "event": "turn_ended",
      "payload": {
        "root_completion": true,
        "opencode_event": "session.idle"
      },
      "expect_state": "idle"
    }
  ],
  "expected": {
    "events": [
      {
        "type": "agent_native_id_bound",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "turn_started",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "turn_ended",
        "source": "hook",
        "scope": "root",
        "outcome": "completed"
      },
      {
        "type": "foreign_conversation_hook_ignored",
        "source": "hook",
        "scope": "root",
        "kind": "SessionStart"
      },
      {
        "type": "turn_started",
        "source": "hook",
        "scope": "root"
      },
      {
        "type": "turn_ended",
        "source": "hook",
        "scope": "root",
        "outcome": "completed"
      }
    ],
    "states": [
      {
        "previous": "idle",
        "state": "working",
        "source": "hook",
        "proof": "proven"
      },
      {
        "previous": "working",
        "state": "idle",
        "source": "hook",
        "proof": "proven"
      },
      {
        "previous": "idle",
        "state": "working",
        "source": "hook",
        "proof": "proven"
      },
      {
        "previous": "working",
        "state": "idle",
        "source": "hook",
        "proof": "proven"
      }
    ],
    "parser": {
      "status": "watching",
      "recognized": 0,
      "unknown": 0,
      "unknown_signatures": {}
    },
    "delivery_state": "unknown",
    "delivery_reason": "readiness_debounce_pending"
  }
}
