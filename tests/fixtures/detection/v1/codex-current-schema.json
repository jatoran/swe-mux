{
  "schema_version": 1,
  "backend": "codex",
  "description": "Representative current Codex records cover tool, approval, compaction, token, and completion parser rules.",
  "steps": [
    {"kind": "transcript", "record": {"type": "session_meta", "payload": {"id": "root", "cwd": "."}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "task_started"}}},
    {"kind": "transcript", "record": {"type": "response_item", "payload": {"type": "function_call", "name": "shell_command", "call_id": "a"}}},
    {"kind": "transcript", "record": {"type": "response_item", "payload": {"type": "function_call_output", "call_id": "a", "output": "ok"}}},
    {"kind": "transcript", "record": {"type": "response_item", "payload": {"type": "custom_tool_call", "name": "image", "call_id": "b"}}},
    {"kind": "transcript", "record": {"type": "response_item", "payload": {"type": "custom_tool_call_output", "call_id": "b", "content": "ok"}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "patch_apply_end", "success": true}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "mcp_tool_call_end", "status": "failed"}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "web_search_end", "status": "complete"}}},
    {"kind": "transcript", "record": {"type": "compacted", "payload": {"type": "context_compacted"}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "token_count", "info": {"model_context_window": 1000, "total_token_usage": {"input_tokens": 100, "output_tokens": 10}}}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "exec_approval_request"}}, "expect_delivery": "blocked", "oracle_safe": false, "expect_state": "awaiting", "expect_awaiting": "approval"},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "task_started"}}},
    {"kind": "transcript", "record": {"type": "event_msg", "payload": {"type": "task_complete"}}},
    {"kind": "terminal", "mode": "normal"},
    {"kind": "timer", "seconds": 2.1, "expect_delivery": "safe", "oracle_safe": true, "expect_state": "idle"}
  ],
  "expected": {
    "events": [
      {"type": "turn_started", "source": "transcript", "scope": "root"},
      {"type": "tool_use", "source": "transcript", "scope": "root", "tool": "shell_command"},
