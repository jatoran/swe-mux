      {"type": "tool_use", "source": "transcript", "scope": "root", "tool": "image"},
      {"type": "tool_result", "source": "transcript", "scope": "root", "tool": "image", "success": true},
      {"type": "tool_result", "source": "transcript", "scope": "root", "tool": "apply_patch", "success": true},
      {"type": "tool_result", "source": "transcript", "scope": "root", "tool": "mcp_tool", "success": false},
      {"type": "tool_result", "source": "transcript", "scope": "root", "tool": "web_search", "success": true},
      {"type": "context_compacted", "source": "transcript", "scope": "root"},
      {"type": "approval_needed", "source": "transcript", "scope": "root", "kind": "approval"},
      {"type": "turn_ended", "source": "transcript", "scope": "root", "outcome": "completed"}
    ],
    "states": [
      {"previous": "idle", "state": "working", "source": "transcript", "proof": "proven"},
      {"previous": "working", "state": "awaiting", "source": "transcript", "proof": "proven", "awaiting_reason": "approval"},
      {"previous": "awaiting", "state": "working", "source": "transcript", "proof": "proven"},
      {"previous": "working", "state": "idle", "source": "transcript", "proof": "proven"}
    ],
    "parser": {"status": "ready", "recognized": 14, "unknown": 0, "unknown_signatures": {}},
    "delivery_state": "safe",
    "delivery_reason": "all_required_evidence_positive"
