{
  "schema_version": 1,
  "backend": "omp",
  "description": "The OMP extension reports a root turn and tool lifecycle before the transcript catches up without treating each provider turn as root completion.",
  "steps": [
    {"kind": "pty_tail", "data": "pi shell\nπ > Opus (sub) ▶"},
    {"kind": "hook", "event": "SessionStart", "payload": {"source": "startup", "session_id": "native-replay", "transcript_path": "omp.jsonl"}},
    {"kind": "hook", "event": "UserPromptSubmit", "payload": {"prompt": "inspect", "omp_event": "before_agent_start"}, "expect_state": "working"},
    {"kind": "hook", "event": "task_started", "payload": {"omp_event": "agent_start"}},
    {"kind": "hook", "event": "turn_started", "payload": {"turn_index": 0, "omp_event": "turn_start"}},
    {"kind": "hook", "event": "PreToolUse", "payload": {"tool_name": "read", "tool_use_id": "call-1", "omp_event": "tool_call"}},
    {"kind": "hook", "event": "PostToolUse", "payload": {"tool_name": "read", "tool_use_id": "call-1", "omp_event": "tool_result"}},
    {"kind": "hook", "event": "turn_ended", "payload": {"turn_index": 0, "root_completion": false, "omp_event": "turn_end"}, "expect_state": "working"},
    {"kind": "hook", "event": "task_complete", "payload": {"will_continue": false, "omp_event": "agent_end"}, "expect_state": "idle"}
  ],
  "expected": {
    "events": [
      {"type": "turn_started", "source": "hook", "scope": "root"},
      {"type": "tool_use", "source": "hook", "scope": "root", "tool": "read"},
      {"type": "provider_turn_ended", "source": "hook", "scope": "root"},
      {"type": "turn_ended", "source": "hook", "scope": "root", "outcome": "completed"}
    ],
    "states": [
      {"previous": "idle", "state": "working", "source": "hook", "proof": "proven"},
      {"previous": "working", "state": "idle", "source": "hook", "proof": "proven"}
    ],
    "parser": {"status": "watching", "recognized": 0, "unknown": 0, "unknown_signatures": {}},
    "delivery_state": "unknown",
    "delivery_reason": "readiness_debounce_pending"
  }
}
