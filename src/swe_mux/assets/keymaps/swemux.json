{
  "id": "swemux",
  "title": "swe-mux",
  "description": "The default. A small flat set on Ctrl+Shift for the things you do constantly, and Ctrl+Shift+Space as a leader for everything else. Ctrl+Shift is what every terminal emulator claims for itself, because Ctrl+<letter> belongs to the shell inside; it is also the one common namespace AltGr does not collide with and no window manager grabs.",
  "leader": "ctrl+shift+space",
  "include": ["leader-tree"],
  "bindings": {
    "ctrl+shift+p": "palette.open",
    "f1": "palette.open",
    "ctrl+shift+enter": "session.spawnShell",
    "ctrl+shift+\\": "pane.splitHorizontal",
    "ctrl+shift+-": "pane.splitVertical",
    "ctrl+shift+z": "pane.zoom",
    "ctrl+shift+x": "pane.close",
    "ctrl+shift+arrowleft": "pane.focusLeft",
    "ctrl+shift+arrowright": "pane.focusRight",
    "ctrl+shift+arrowup": "pane.focusUp",
    "ctrl+shift+arrowdown": "pane.focusDown",
    "ctrl+shift+[": "tab.previous",
    "ctrl+shift+]": "tab.next",
    "ctrl+shift+f": "terminal.find",
    "ctrl+shift+e": "drawer.files",
    "ctrl+shift+g": "drawer.git",
    "ctrl+shift+u": "drawer.queue",
    "ctrl+shift+k": "drawer.transcript",
    "ctrl+shift+l": "drawer.toggle",
    "ctrl+shift+s": "sidebar.toggle",
    "ctrl+shift+,": "settings.open",
    "ctrl+shift+h": "history.open",
    "ctrl+shift+;": "broadcast.toggle",
    "ctrl+shift+'": "focus.terminal",
    "ctrl+shift+.": "focus.next",
    "ctrl+shift+/": "help.open",
    "ctrl+shift+1": "project.activate(1)",
    "ctrl+shift+2": "project.activate(2)",
    "ctrl+shift+3": "project.activate(3)",
    "ctrl+shift+4": "project.activate(4)",
    "ctrl+shift+5": "project.activate(5)",
    "ctrl+shift+6": "project.activate(6)",
    "ctrl+shift+7": "project.activate(7)",
    "ctrl+shift+8": "project.activate(8)",
    "ctrl+shift+9": "project.activate(9)"
  },
  "rules": [
    {
      "keys": "ctrl+tab",
      "command": "tab.next",
      "host": "desktop",
      "note": "A browser tab keeps Ctrl+Tab for itself; the desktop app releases it."
    },
    {
      "keys": "ctrl+shift+tab",
      "command": "tab.previous",
      "host": "desktop",
      "note": "A browser tab keeps Ctrl+Shift+Tab for itself; the desktop app releases it."
    },
    {
      "keys": "meta+shift+p",
      "command": "palette.open",
      "platform": "mac",
      "note": "Cmd is the primary modifier on macOS, so the Ctrl+Shift set above is mirrored onto it. Both work; nothing was taken away. The leader stays Ctrl+Shift+Space, which is free on macOS - Cmd+Space is Spotlight."
    },
    { "keys": "meta+shift+enter", "command": "session.spawnShell", "platform": "mac" },
    { "keys": "meta+shift+\\", "command": "pane.splitHorizontal", "platform": "mac" },
    { "keys": "meta+shift+-", "command": "pane.splitVertical", "platform": "mac" },
    { "keys": "meta+shift+z", "command": "pane.zoom", "platform": "mac" },
    { "keys": "meta+shift+x", "command": "pane.close", "platform": "mac" },
    { "keys": "meta+shift+arrowleft", "command": "pane.focusLeft", "platform": "mac" },
    { "keys": "meta+shift+arrowright", "command": "pane.focusRight", "platform": "mac" },
    { "keys": "meta+shift+arrowup", "command": "pane.focusUp", "platform": "mac" },
    { "keys": "meta+shift+arrowdown", "command": "pane.focusDown", "platform": "mac" },
    { "keys": "meta+shift+[", "command": "tab.previous", "platform": "mac" },
    { "keys": "meta+shift+]", "command": "tab.next", "platform": "mac" },
    { "keys": "meta+shift+f", "command": "terminal.find", "platform": "mac" },
    { "keys": "meta+shift+e", "command": "drawer.files", "platform": "mac" },
    { "keys": "meta+shift+g", "command": "drawer.git", "platform": "mac" },
    { "keys": "meta+shift+u", "command": "drawer.queue", "platform": "mac" },
    { "keys": "meta+shift+k", "command": "drawer.transcript", "platform": "mac" },
    { "keys": "meta+shift+l", "command": "drawer.toggle", "platform": "mac" },
    { "keys": "meta+shift+s", "command": "sidebar.toggle", "platform": "mac" },
    { "keys": "meta+,", "command": "settings.open", "platform": "mac" },
    { "keys": "meta+shift+h", "command": "history.open", "platform": "mac" }
  ]
}
