{
  "id": "tmux",
  "title": "tmux",
  "description": "The tmux prefix and its letters, mapped onto swe-mux's panes, tabs and sessions. Read the warning before choosing it: swe-mux is an outer shell, so taking Ctrl+B here takes it away from any tmux running INSIDE a pane. If you use tmux inside swe-mux, rebind this preset's prefix to Ctrl+A (or the other way round) - one of the two has to give it up.",
  "leader": "ctrl+shift+space",
  "prefix": "ctrl+b",
  "prefix_alternates": ["ctrl+a"],
  "warning": "Ctrl+B is tmux's own prefix. If you run tmux inside a swe-mux pane, swe-mux will now eat it before tmux sees it. Ctrl+A is the usual escape from that collision and is one edit away in Settings.",
  "include": ["leader-tree"],
  "bindings": {
    "ctrl+b c": "session.spawnShell",
    "ctrl+b shift+5": "pane.splitHorizontal",
    "ctrl+b shift+'": "pane.splitVertical",
    "ctrl+b n": "tab.next",
    "ctrl+b p": "tab.previous",
    "ctrl+b o": "pane.next",
    "ctrl+b ;": "pane.previous",
    "ctrl+b arrowleft": "pane.focusLeft",
    "ctrl+b arrowright": "pane.focusRight",
    "ctrl+b arrowup": "pane.focusUp",
    "ctrl+b arrowdown": "pane.focusDown",
    "ctrl+b shift+arrowleft": "pane.swapLeft",
    "ctrl+b shift+arrowright": "pane.swapRight",
    "ctrl+b shift+arrowup": "pane.swapUp",
    "ctrl+b shift+arrowdown": "pane.swapDown",
    "ctrl+b z": "pane.zoom",
    "ctrl+b x": "pane.close",
    "ctrl+b shift+1": "pane.detach",
    "ctrl+b d": "drawer.toggle",
    "ctrl+b ,": "session.rename",
    "ctrl+b shift+7": "session.kill",
    "ctrl+b w": "palette.sessions",
    "ctrl+b s": "palette.projects",
    "ctrl+b shift+[": "pane.swapLeft",
    "ctrl+b shift+]": "pane.swapRight",
    "ctrl+b [": "terminal.find",
    "ctrl+b ]": "terminal.paste",
    "ctrl+b shift+/": "help.open",
    "ctrl+b space": "pane.next",
    "ctrl+b t": "focus.terminal",
    "ctrl+b shift+.": "stack.tabRight",
    "ctrl+b shift+,": "stack.tabLeft",
    "ctrl+b 1": "tab.activate(1)",
    "ctrl+b 2": "tab.activate(2)",
    "ctrl+b 3": "tab.activate(3)",
    "ctrl+b 4": "tab.activate(4)",
    "ctrl+b 5": "tab.activate(5)",
    "ctrl+b 6": "tab.activate(6)",
    "ctrl+b 7": "tab.activate(7)",
    "ctrl+b 8": "tab.activate(8)",
    "ctrl+b 9": "tab.activate(9)",
    "ctrl+shift+p": "palette.open",
    "f1": "palette.open"
  }
}
