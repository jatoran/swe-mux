{
  "id": "vscode",
  "title": "VS Code",
  "description": "VS Code's chords where swe-mux has the same idea: the palette, the explorer/git/extensions panels, split and terminal, and the Ctrl+K chord prefix. Panes here are VS Code's editor groups and tabs are its editor tabs, which is the closest honest mapping.",
  "leader": "ctrl+shift+space",
  "prefix": "ctrl+k",
  "warning": "Ctrl+K is a shell's kill-to-end-of-line and Ctrl+B is tmux's prefix. Both are taken from whatever runs inside a pane while this preset is active.",
  "include": ["leader-tree"],
  "bindings": {
    "ctrl+shift+p": "palette.open",
    "f1": "palette.open",
    "ctrl+p": "palette.files",
    "ctrl+shift+e": "drawer.files",
    "ctrl+shift+g": "drawer.git",
    "ctrl+shift+x": "drawer.actions",
    "ctrl+shift+u": "drawer.transcript",
    "ctrl+shift+f": "terminal.find",
    "ctrl+b": "sidebar.toggle",
    "ctrl+j": "drawer.toggle",
    "ctrl+`": "session.spawnShell",
    "ctrl+shift+`": "session.spawnShell",
    "ctrl+\\": "pane.splitHorizontal",
    "ctrl+,": "settings.open",
    "ctrl+k ctrl+s": "settings.open",
    "ctrl+k ctrl+\\": "pane.splitVertical",
    "ctrl+k z": "pane.zoom",
    "ctrl+k ctrl+w": "pane.close",
    "ctrl+k ctrl+arrowleft": "pane.focusLeft",
    "ctrl+k ctrl+arrowright": "pane.focusRight",
    "ctrl+k ctrl+arrowup": "pane.focusUp",
    "ctrl+k ctrl+arrowdown": "pane.focusDown",
    "ctrl+k ctrl+shift+arrowleft": "pane.swapLeft",
    "ctrl+k ctrl+shift+arrowright": "pane.swapRight",
    "ctrl+k ctrl+shift+arrowup": "pane.swapUp",
    "ctrl+k ctrl+shift+arrowdown": "pane.swapDown",
    "ctrl+k ctrl+o": "project.add",
    "ctrl+k f": "project.files",
    "ctrl+k ctrl+t": "settings.open",
    "ctrl+shift+[": "tab.previous",
    "ctrl+shift+]": "tab.next",
    "alt+1": "tab.activate(1)",
    "alt+2": "tab.activate(2)",
    "alt+3": "tab.activate(3)",
    "alt+4": "tab.activate(4)",
    "alt+5": "tab.activate(5)",
    "alt+6": "tab.activate(6)",
    "alt+7": "tab.activate(7)",
    "alt+8": "tab.activate(8)",
    "alt+9": "tab.activate(9)"
  },
  "rules": [
    { "keys": "ctrl+pageup", "command": "tab.previous", "host": "desktop" },
    { "keys": "ctrl+pagedown", "command": "tab.next", "host": "desktop" },
    { "keys": "meta+shift+p", "command": "palette.open", "platform": "mac" },
    { "keys": "meta+p", "command": "palette.files", "platform": "mac" },
    { "keys": "meta+shift+e", "command": "drawer.files", "platform": "mac" },
    { "keys": "meta+shift+g", "command": "drawer.git", "platform": "mac" },
    { "keys": "meta+b", "command": "sidebar.toggle", "platform": "mac" },
    { "keys": "meta+j", "command": "drawer.toggle", "platform": "mac" },
    { "keys": "meta+\\", "command": "pane.splitHorizontal", "platform": "mac" },
    { "keys": "meta+,", "command": "settings.open", "platform": "mac" }
  ]
}
