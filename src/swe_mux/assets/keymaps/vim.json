{
  "id": "vim",
  "title": "Vim-flavoured",
  "description": "hjkl everywhere, Ctrl+W for window movement, and Alt as the browser-safe mirror of it. Deliberately NOT a modal layer: a terminal is already modal and the agent TUIs inside it are too, so a normal/insert mode over the top produces keystrokes nobody can attribute. What you get is vim's directional vocabulary, not vim's state machine.",
  "leader": "ctrl+shift+space",
  "prefix": "ctrl+w",
  "warning": "Ctrl+W is a shell's delete-word, and a browser tab closes on it before the page ever sees it - so every Ctrl+W binding here is desktop-app only, and the Alt+hjkl set beside it is the one that works in a browser.",
  "include": ["leader-tree"],
  "bindings": {
    "alt+h": "pane.focusLeft",
    "alt+j": "pane.focusDown",
    "alt+k": "pane.focusUp",
    "alt+l": "pane.focusRight",
    "alt+shift+h": "pane.swapLeft",
    "alt+shift+j": "pane.swapDown",
    "alt+shift+k": "pane.swapUp",
    "alt+shift+l": "pane.swapRight",
    "alt+s": "pane.splitVertical",
    "alt+v": "pane.splitHorizontal",
    "alt+z": "pane.zoom",
    "alt+q": "pane.close",
    "alt+n": "tab.next",
    "alt+p": "tab.previous",
    "alt+b": "palette.sessions",
    "alt+o": "palette.files",
    "alt+e": "palette.projects",
    "alt+/": "terminal.find",
    "alt+shift+/": "help.open",
    "ctrl+shift+;": "palette.commands",
    "ctrl+shift+p": "palette.open",
    "f1": "palette.open",
    "alt+1": "tab.activate(1)",
    "alt+2": "tab.activate(2)",
    "alt+3": "tab.activate(3)",
    "alt+4": "tab.activate(4)",
    "alt+5": "tab.activate(5)",
    "alt+6": "tab.activate(6)",
    "alt+7": "tab.activate(7)",
    "alt+8": "tab.activate(8)",
    "alt+9": "tab.activate(9)"
  },
  "rules": [
    { "keys": "ctrl+w h", "command": "pane.focusLeft", "host": "desktop" },
    { "keys": "ctrl+w j", "command": "pane.focusDown", "host": "desktop" },
    { "keys": "ctrl+w k", "command": "pane.focusUp", "host": "desktop" },
    { "keys": "ctrl+w l", "command": "pane.focusRight", "host": "desktop" },
    { "keys": "ctrl+w arrowleft", "command": "pane.focusLeft", "host": "desktop" },
    { "keys": "ctrl+w arrowdown", "command": "pane.focusDown", "host": "desktop" },
    { "keys": "ctrl+w arrowup", "command": "pane.focusUp", "host": "desktop" },
    { "keys": "ctrl+w arrowright", "command": "pane.focusRight", "host": "desktop" },
    { "keys": "ctrl+w shift+h", "command": "pane.swapLeft", "host": "desktop" },
    { "keys": "ctrl+w shift+j", "command": "pane.swapDown", "host": "desktop" },
    { "keys": "ctrl+w shift+k", "command": "pane.swapUp", "host": "desktop" },
    { "keys": "ctrl+w shift+l", "command": "pane.swapRight", "host": "desktop" },
    { "keys": "ctrl+w s", "command": "pane.splitVertical", "host": "desktop" },
    { "keys": "ctrl+w v", "command": "pane.splitHorizontal", "host": "desktop" },
    { "keys": "ctrl+w c", "command": "pane.close", "host": "desktop" },
    { "keys": "ctrl+w q", "command": "pane.close", "host": "desktop" },
    { "keys": "ctrl+w o", "command": "pane.zoom", "host": "desktop" },
    { "keys": "ctrl+w w", "command": "pane.next", "host": "desktop" },
    { "keys": "ctrl+w shift+w", "command": "pane.previous", "host": "desktop" },
    { "keys": "ctrl+w x", "command": "pane.swapNext", "host": "desktop" },
    { "keys": "ctrl+w t", "command": "pane.stackNew", "host": "desktop" },
    { "keys": "ctrl+w shift+,", "command": "pane.resizeLeft", "host": "desktop" },
    { "keys": "ctrl+w shift+.", "command": "pane.resizeRight", "host": "desktop" },
    { "keys": "ctrl+w shift+=", "command": "pane.resizeUp", "host": "desktop" },
    { "keys": "ctrl+w -", "command": "pane.resizeDown", "host": "desktop" },
    { "keys": "meta+shift+;", "command": "palette.commands", "platform": "mac" }
  ]
}
