[
 {
  "path": [
   "presets",
   "0",
   "description"
  ],
  "value": "将 C-x 前缀和 M-x 映射到 swe-mux 的窗口与缓冲区：C-x 2、C-x 3 拆分窗格，C-x o 切换窗格，C-x 0、C-x 1 关闭或最大化窗格，C-x b 列出“缓冲区”（会话），C-x g 打开 Git。"
 },
 {
  "path": [
   "presets",
   "0",
   "warning"
  ],
  "value": "C-x 也是 Emacs 和 readline Shell 的前缀。启用此预设后，窗格中的 Emacs 将无法收到它。这里保留 C-c、C-a、C-e、C-k 的原有用途，以免影响常用 Shell 操作。"
 },
 {
  "path": [
   "presets",
   "1",
   "description"
  ],
  "value": "默认方案。常用操作使用少量 Ctrl+Shift 组合键，其余操作通过 Ctrl+Shift+Space 前缀访问。终端通常将 Ctrl+Shift 留给自身，因为 Ctrl+字母 属于内部 Shell；它也避免了 AltGr 和常见窗口管理器快捷键的冲突。"
 },
 {
  "path": [
   "presets",
   "2",
   "description"
  ],
  "value": "将 tmux 前缀及其字母命令映射到 swe-mux 的窗格、标签页和会话。选择之前请阅读警告：swe-mux 位于外层，在这里接管 Ctrl+B 后，窗格内的 tmux 就无法收到它。如果你还在窗格里使用 tmux，请将其中一方的前缀改为 Ctrl+A 或其他按键，避免冲突。"
 },
 {
  "path": [
   "presets",
   "2",
   "warning"
  ],
  "value": "Ctrl+B 是 tmux 自身的前缀。如果你在 swe-mux 窗格中运行 tmux，swe-mux 会先接管该按键。通常可将其中一方改用 Ctrl+A，在设置中即可修改。"
 },
 {
  "path": [
   "presets",
   "3",
   "title"
  ],
  "value": "Vim 风格"
 },
 {
  "path": [
   "presets",
   "3",
   "description"
  ],
  "value": "使用 hjkl 方向键习惯，以 Ctrl+W 控制窗格，并提供可用于浏览器的 Alt 组合键。不额外增加普通/插入模式，因为终端和其中的智能体界面已有自己的模式。此预设提供 Vim 的方向操作习惯。"
 },
 {
  "path": [
   "presets",
   "3",
   "warning"
  ],
  "value": "Ctrl+W 在 Shell 中用于删除单词，浏览器也会先用它关闭标签页。因此这里的 Ctrl+W 绑定仅限桌面应用；浏览器请使用对应的 Alt+hjkl 组合键。"
 },
 {
  "path": [
   "presets",
   "4",
   "description"
  ],
  "value": "将 VS Code 中对应的操作映射到 swe-mux：命令面板、资源管理器、Git、扩展、拆分、终端和 Ctrl+K 前缀。这里的窗格对应 VS Code 编辑器组，标签页对应编辑器标签。"
 },
 {
  "path": [
   "presets",
   "4",
   "warning"
  ],
  "value": "Ctrl+K 在 Shell 中用于删除至行尾，Ctrl+B 是 tmux 的前缀。启用此预设后，这两个按键会被 swe-mux 接管，窗格内的程序将无法收到它们。"
 },
