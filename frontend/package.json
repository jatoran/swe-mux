{
  "name": "swe-mux-frontend",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "postinstall": "node scripts/patch-xterm-webgl.mjs",
    "prebuild": "node scripts/patch-xterm-webgl.mjs --check",
    "build": "tsc && vite build",
    "precheck": "node scripts/patch-xterm-webgl.mjs --check",
    "check": "tsc --noEmit",
    "pretest": "node scripts/patch-xterm-webgl.mjs --check",
    "test": "node --experimental-strip-types test/all.ts",
    "test:renderer": "playwright test --config playwright.renderer.config.ts"
  },
  "dependencies": {
    "@continuity-editor/editor": "file:vendor/continuity-editor-0.2.19.tgz",
    "@xterm/addon-clipboard": "^0.2.0",
    "@xterm/addon-fit": "^0.11.0",
    "@xterm/addon-search": "^0.16.0",
    "@xterm/addon-unicode11": "^0.9.0",
    "@xterm/addon-web-links": "^0.12.0",
    "@xterm/addon-webgl": "^0.19.0",
    "@xterm/xterm": "^6.0.0",
    "preact": "^10.26.4",
    "react-diff-view": "^3.3.3"
  },
  "devDependencies": {
    "@preact/preset-vite": "^2.10.1",
    "playwright": "^1.61.1",
    "typescript": "^5.8.2",
    "vite": "^6.2.2"
  }
}
