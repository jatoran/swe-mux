#!/usr/bin/env bash
# Guards that make free `git commit` safe for agents:
#   1. no commits directly onto a protected branch
#   2. no secret-bearing files or credential-shaped strings in the staged diff
# Bypassing this with --no-verify is blocked by ~/.claude/hooks/security-validator.ts.
set -euo pipefail

branch="$(git rev-parse --abbrev-ref HEAD 2>/dev/null || echo HEAD)"
case "$branch" in
    main|master|integration|develop|release/*)
        echo "pre-commit: refusing to commit directly onto '$branch'." >&2
        echo "  Agents: run 'wt new <slug>' and work on an agent/* branch." >&2
        echo "  Humans: HUMAN=1 git commit ... to override." >&2
        [ "${HUMAN:-}" = "1" ] || exit 1
        echo "pre-commit: HUMAN=1 set, allowing." >&2
        ;;
esac

staged="$(git diff --cached --name-only --diff-filter=ACMR)"
[ -n "$staged" ] || exit 0

if printf '%s\n' "$staged" | grep -qiE '(^|/)\.env(\.|$)|\.(pem|p12|pfx|key|keystore|jks)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$|(^|/)\.npmrc$|(^|/)\.netrc$|(^|/)credentials(\.json)?$'; then
    echo "pre-commit: refusing to commit a secret-bearing file:" >&2
    printf '%s\n' "$staged" | grep -iE '(^|/)\.env(\.|$)|\.(pem|p12|pfx|key|keystore|jks)$|(^|/)id_(rsa|dsa|ecdsa|ed25519)$|(^|/)\.npmrc$|(^|/)\.netrc$|(^|/)credentials(\.json)?$' >&2
    exit 1
fi

if git diff --cached -U0 --diff-filter=ACMR \
    | grep -E '^\+' \
    | grep -qE 'AKIA[0-9A-Z]{16}|ASIA[0-9A-Z]{16}|sk-(proj-)?[A-Za-z0-9_-]{20,}|sk-ant-[A-Za-z0-9_-]{20,}|gh[pousr]_[A-Za-z0-9]{20,}|xox[baprs]-[A-Za-z0-9-]{10,}|-----BEGIN [A-Z ]*PRIVATE KEY-----|AIza[0-9A-Za-z_-]{35}'; then
    echo "pre-commit: staged diff contains a credential-shaped string." >&2
    echo "  Remove it, or set HUMAN=1 if this is a false positive." >&2
    [ "${HUMAN:-}" = "1" ] || exit 1
fi

exit 0
